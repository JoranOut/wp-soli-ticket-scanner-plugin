{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.0.4.zip",
  "phpVersion": "8.2",
  "plugins": ["."],
  "themes": [],
  "mappings": {
    "wp-content/mu-plugins": "./e2e/mu-plugins",
    "wp-content/soli-e2e": "./e2e"
  },
  "port": 8906,
  "testsPort": 8907,
  "env": {
    "development": {
      "port": 8906,
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "WP_MEMORY_LIMIT": "512M"
      }
    },
    "tests": {
      "port": 8907,
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "WP_MEMORY_LIMIT": "512M"
      }
    }
  },
  "lifecycleScripts": {
    "afterStart": "bash .wp-env-setup.sh"
  }
}
